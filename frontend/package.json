{
  "name": "wallet-comparison-frontend",
  "version": "0.1.0",
  "description": "Developer-focused crypto wallet comparison site generated from Markdown",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export:brands": "node scripts/export-brands.js",
    "start": "sh -c 'test -d out || { echo \"Run bun run build before bun run start.\" >&2; exit 1; }; python3 -m http.server 3000 --directory out'",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "node scripts/smoke-test-wallet-data.js",
    "generate-og": "node scripts/generate-og-images.js",
    "validate-cards": "node scripts/validate-twitter-cards.js",
    "check-links": "node scripts/check-links.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "canvas": "^3.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
